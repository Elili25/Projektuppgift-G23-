@{
    ViewData["Title"] = "Skapa konto";
}

<link rel="stylesheet" href="~/css/Sevent-Auth.css" asp-append-version="true" />

<section class="auth">
    <div class="auth__card">
        <span class="auth__badge">Nytt konto</span>
        <h1 class="auth__title">Skapa konto</h1>
        <p class="auth__lead">Det tar en minut. Efteråt är du inloggad och kan boka direkt.</p>

        @if (ViewBag.Error != null)
        {
            <div class="auth__error" role="alert">@ViewBag.Error</div>
        }

        <form asp-action="Register" method="post">
            <div class="auth__field">
                <label for="name">Namn</label>
                <input id="name" name="name" placeholder="För- och efternamn" value="@ViewBag.Name" autocomplete="name" required />
            </div>
            <div class="auth__field">
                <label for="mail">E-post</label>
                <input id="mail" type="email" name="mail" placeholder="namn@exempel.se" value="@ViewBag.Mail" autocomplete="email" required />
            </div>
            <div class="auth__field">
                <label for="phone">Telefon</label>
                <input id="phone" name="phone" placeholder="070-000 00 00" value="@ViewBag.Phone" autocomplete="tel" />
            </div>
            <div class="auth__field">
                <label for="password">Lösenord</label>
                <input id="password" type="password" name="password" placeholder="Minst 8 tecken" autocomplete="new-password" required minlength="8" />
                <div class="auth__hint">Minst 8 tecken.</div>
            </div>

            <button class="auth__submit" type="submit">Skapa konto</button>
        </form>

        <p class="auth__switch">
            Har du redan ett konto? <a asp-action="Login">Logga in</a>
        </p>
    </div>
</section>
