@{
    ViewData["Title"] = "Create account";
}

<link rel="stylesheet" href="~/css/Sevent-Auth.css" asp-append-version="true" />

<section class="auth">
    <div class="auth__card">
        <span class="auth__badge">New account</span>
        <h1 class="auth__title">Create account</h1>
        <p class="auth__lead">It takes a minute. Afterwards you're logged in and can book right away.</p>

        @if (ViewBag.Error != null)
        {
            <div class="auth__error" role="alert">@ViewBag.Error</div>
        }

        <form asp-action="Register" method="post">
            <div class="auth__field">
                <label for="name">Name</label>
                <input id="name" name="name" placeholder="First and last name" value="@ViewBag.Name" autocomplete="name" required />
            </div>
            <div class="auth__field">
                <label for="mail">Email</label>
                <input id="mail" type="email" name="mail" placeholder="name@example.com" value="@ViewBag.Mail" autocomplete="email" required />
            </div>
            <div class="auth__field">
                <label for="phone">Phone</label>
                <input id="phone" name="phone" placeholder="070-000 00 00" value="@ViewBag.Phone" autocomplete="tel" />
            </div>
            <div class="auth__field">
                <label for="password">Password</label>
                <input id="password" type="password" name="password" placeholder="At least 8 characters" autocomplete="new-password" required minlength="8" />
                <div class="auth__hint">At least 8 characters.</div>
            </div>

            <button class="auth__submit" type="submit">Create account</button>
        </form>

        <p class="auth__switch">
            Already have an account? <a asp-action="Login">Log in</a>
        </p>
    </div>
</section>
