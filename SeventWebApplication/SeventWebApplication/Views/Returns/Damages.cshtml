@using SeventWebApplication.Models.Admin
@model List<DamageRowViewModel>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Damages";
}

<div class="adm-pagehead">
    <h2>@Model.Count(d => !d.IsResolved) open damage(s)</h2>
</div>

<section class="adm-card adm-panel">
    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead>
                <tr>
                    <th scope="col">Vehicle</th>
                    <th scope="col">Description</th>
                    <th scope="col">Reported</th>
                    <th scope="col">Status</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@d.Vehicle<br /><small>@d.RegNr</small></td>
                        <td>@d.Description</td>
                        <td>@d.ReportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (d.IsResolved)
                            {
                                <span class="adm-status adm-status--completed">Repaired</span>
                            }
                            else
                            {
                                <span class="adm-status adm-status--inrepair">Open</span>
                            }
                        </td>
                        <td>
                            @if (!d.IsResolved)
                            {
                                <form class="adm-inline" method="post" asp-action="Resolve" asp-route-id="@d.DamageId">
                                    <button class="adm-btn adm-btn--ok" type="submit">Mark as repaired</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr class="adm-table__empty"><td colspan="5">No damages registered.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>
