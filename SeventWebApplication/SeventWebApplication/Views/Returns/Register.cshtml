@using SeventWebApplication.Models.Admin
@using SeventWebApplication.Models.VehicleNS
@model ReturnPageViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Register return";
}

<section class="adm-card adm-panel">
    @if (Model.ActiveBookings.Count == 0)
    {
        <p>There are no active rentals to return.</p>
    }
    else
    {
        <form method="post" asp-action="Register">
            @if (ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
            {
                <ul class="adm-errors">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@e.ErrorMessage</li>
                    }
                </ul>
            }

            <div class="adm-form">
                <label class="adm-field adm-field--wide">Booking
                    <select name="BookingId">
                        <option value="">– choose active rental –</option>
                        @foreach (var b in Model.ActiveBookings)
                        {
                            <option value="@b.BookingId" selected="@(b.BookingId == Model.Form.BookingId)">
                                @b.ShortId – @b.CustomerName – @b.Vehicle @b.RegNr (due @b.End.ToString("yyyy-MM-dd"))
                            </option>
                        }
                    </select>
                </label>
                <label class="adm-field">Mileage (km)
                    <input name="Mileage" type="number" value="@Model.Form.Mileage" />
                </label>
                <label class="adm-field">Fuel level
                    <input name="FuelLevel" type="number" step="any" value="@Model.Form.FuelLevel" />
                </label>
                <label class="adm-field">Battery level
                    <input name="BatteryLevel" type="number" step="any" value="@Model.Form.BatteryLevel" />
                </label>
                <label class="adm-field">Inspection result
                    <select name="InspectionResult" asp-items="Html.GetEnumSelectList<InspectionResult>()"></select>
                </label>
                <label class="adm-field adm-field--wide">Damages
                    <textarea name="Damages" rows="3">@Model.Form.Damages</textarea>
                    <small>One damage per line. Leave empty if there are none. A damaged vehicle is set to InRepair.</small>
                </label>
                <label class="adm-field adm-field--wide">Notes
                    <textarea name="Notes" rows="2">@Model.Form.Notes</textarea>
                </label>
            </div>

            <p style="margin-top:18px">
                <button class="adm-btn" type="submit">Register return</button>
            </p>
        </form>
    }
</section>
