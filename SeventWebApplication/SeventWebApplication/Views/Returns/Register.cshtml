@using SeventWebApplication.Models.Admin
@using SeventWebApplication.Models.VehicleNS
@model ReturnPageViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Register return";
}

<section class="adm-card adm-panel">
    @if (Model.ActiveBookings.Count == 0)
    {
        <p>There are no active rentals to return.</p>
    }
    else
    {
        <form method="post" asp-action="Register" id="return-form">
            @if (ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
            {
                <ul class="adm-errors">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@e.ErrorMessage</li>
                    }
                </ul>
            }

            <div class="adm-form">
                <label class="adm-field adm-field--wide">Booking
                    <select name="BookingId">
                        <option value="">– choose active rental –</option>
                        @foreach (var b in Model.ActiveBookings)
                        {
                            <option value="@b.BookingId" data-planned-end="@b.End.ToString("yyyy-MM-ddTHH:mm:ss")" selected="@(b.BookingId == Model.Form.BookingId)">
                                @b.ShortId – @b.CustomerName – @b.Vehicle @b.RegNr (due @b.End.ToString("yyyy-MM-dd"))
                            </option>
                        }
                    </select>
                </label>
                <label class="adm-field">Returned at
                    <input name="ReturnedAt" type="datetime-local" max="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                           value="@Model.Form.ReturnedAt?.ToString("yyyy-MM-ddTHH:mm")" />
                    <small>When the customer actually returned the vehicle. Leave empty for now. Late fees are counted from this time.</small>
                </label>
                <label class="adm-field">Mileage (km)
                    <input name="Mileage" type="number" value="@Model.Form.Mileage" />
                </label>
                <label class="adm-field">Fuel level (%)
                    <input name="FuelLevel" type="number" step="any" min="0" max="100" value="@Model.Form.FuelLevel" />
                </label>
                <label class="adm-field">Battery level (%)
                    <input name="BatteryLevel" type="number" step="any" min="0" max="100" value="@Model.Form.BatteryLevel" />
                </label>
                <label class="adm-field">Inspection result
                    <select name="InspectionResult" asp-items="Html.GetEnumSelectList<InspectionResult>()"></select>
                </label>
                <label class="adm-field adm-field--wide">Damages
                    <textarea name="Damages" rows="3">@Model.Form.Damages</textarea>
                    <small>One damage per line. Leave empty if there are none. A damaged vehicle is set to InRepair.</small>
                </label>
                <label class="adm-field">Damage fee (kr)
                    <input name="DamageFee" type="number" step="any" min="0" value="@Model.Form.DamageFee" />
                    <small>Charged to the customer. Leave 0 if there is no fee.</small>
                </label>
                <label class="adm-field adm-field--wide">Notes
                    <textarea name="Notes" rows="2">@Model.Form.Notes</textarea>
                </label>
            </div>

            <p style="margin-top:18px">
                <button class="adm-btn" type="submit">Register return</button>
            </p>
        </form>
    }
</section>

@section Scripts {
    <script>
        // Warns on early return (before the booking's planned end)
        (function () {
            var form = document.getElementById("return-form");
            if (!form) return;
            form.addEventListener("submit", function (e) {
                var sel = form.querySelector("select[name=BookingId]");
                var opt = sel && sel.options[sel.selectedIndex];
                var planned = opt && opt.getAttribute("data-planned-end");
                if (!planned) return;
                var end = new Date(planned);
                var at = form.querySelector("[name=ReturnedAt]").value;
                var returned = at ? new Date(at) : new Date();
                if (returned >= end) return;
                var sameDay = end.toDateString() === new Date().toDateString();
                var time = end.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" });
                var when = sameDay ? "at " + time
                    : "on " + end.toLocaleDateString("en-GB", { day: "numeric", month: "short" }) + " at " + time;
                if (!confirm("The booking ends " + when + ". Register the return anyway?"))
                    e.preventDefault();
            });
        })();
    </script>
}
