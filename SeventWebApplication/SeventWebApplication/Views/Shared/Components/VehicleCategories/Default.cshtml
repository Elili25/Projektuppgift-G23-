@*
    "Explore Our Vehicle Families": en rad med rutor (en per bil- och skåpbilskategori), direkt under hero.
    Data: VehicleFamilyService.GetVehicleCategoryTiles(). Styles: wwwroot/css/Sevent-VehicleFamilies.css
*@
@model List<SeventWebApplication.ViewModels.VehicleCategoryTileViewModel>

<link rel="stylesheet" href="~/css/Sevent-VehicleFamilies.css" asp-append-version="true" />

<section class="vf" aria-labelledby="vf-title">

    <header class="vf__head">
        <h2 id="vf-title">Explore Our Cars and Vans</h2>
        <a class="vf__all" asp-controller="Vehicles" asp-action="Cars">
            View all vehicles
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
    </header>

    <ul class="vf__grid">
        @foreach (var t in Model)
        {
            <li>
                @if (t.IsAvailable)
                {
                    @* Rutan öppnar produktsidan för familjen *@
                    <a class="vf__card" asp-controller="Vehicles" asp-action="Family" asp-route-id="@t.FamilyId">
                        <span class="vf__media">
                            @if (!string.IsNullOrEmpty(t.ImagePath))
                            {
                                <img src="@t.ImagePath" alt="@t.Label" loading="lazy" />
                            }
                        </span>
                        <span class="vf__row">
                            <span class="vf__text">
                                <strong>@t.Label</strong>
                                <small>@t.Description</small>
                            </span>
                            <span class="vf__arrow" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                            </span>
                        </span>
                    </a>
                }
                else
                {
                    <div class="vf__card is-soon">
                        <span class="vf__media">
                            @if (!string.IsNullOrEmpty(t.ImagePath))
                            {
                                <img src="@t.ImagePath" alt="@t.Label" loading="lazy" />
                            }
                        </span>
                        <span class="vf__row">
                            <span class="vf__text">
                                <strong>@t.Label</strong>
                                <small>Coming soon</small>
                            </span>
                        </span>
                    </div>
                }
            </li>
        }
    </ul>
</section>
