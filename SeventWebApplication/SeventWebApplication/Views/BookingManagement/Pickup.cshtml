@using SeventWebApplication.Models.Admin
@model PickupPageViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Register pickup";
    var b = Model.Booking;
}

<section class="adm-card adm-panel">
    <p>
        Booking <strong>#@b.ShortId</strong> – @b.CustomerName – @b.Vehicle @b.RegNr<br />
        <small>@b.Start.ToString("yyyy-MM-dd HH:mm") → @b.End.ToString("yyyy-MM-dd HH:mm")</small>
    </p>

    <form method="post" asp-action="Pickup" id="pickup-form" data-planned-start="@b.Start.ToString("yyyy-MM-ddTHH:mm:ss")" data-earliest-pickup="@Model.EarliestPickup.ToString("yyyy-MM-ddTHH:mm:ss")">
        @if (ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
        {
            <ul class="adm-errors">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@e.ErrorMessage</li>
                }
            </ul>
        }

        @if (!Model.CanPickupNow)
        {
            <p class="adm-errors" id="pickup-closed-note">Pickup opens @Model.EarliestPickup.ToString("yyyy-MM-dd HH:mm").</p>
        }

        <input type="hidden" name="BookingId" value="@Model.Form.BookingId" />

        <div class="adm-form">
            <label class="adm-field">Mileage (km)
                <input name="Mileage" type="number" min="0" value="@Model.Form.Mileage" />
            </label>
            <label class="adm-field">Fuel level (%)
                <input name="FuelLevel" type="number" step="any" min="0" max="100" value="@Model.Form.FuelLevel" />
            </label>
            <label class="adm-field">Battery level (%)
                <input name="BatteryLevel" type="number" step="any" min="0" max="100" value="@Model.Form.BatteryLevel" />
            </label>
            <label class="adm-field adm-field--wide">Notes
                <textarea name="Notes" rows="2">@Model.Form.Notes</textarea>
            </label>
        </div>

        <p style="margin-top:18px">
            <button class="adm-btn adm-btn--ok" type="submit" id="pickup-submit" disabled="@(!Model.CanPickupNow)">Register pickup</button>
            <a class="adm-btn" asp-action="Confirmed">Back</a>
        </p>
    </form>
</section>

@section Scripts {
    <script>
        // Warns if the vehicle is picked up before the booked start time
        (function () {
            var form = document.getElementById("pickup-form");
            var start = new Date(form.getAttribute("data-planned-start"));
            // The earliest allowed pickup comes from RentalReturnService (the server)
            var earliest = new Date(form.getAttribute("data-earliest-pickup"));

            // Enable the button when pickup opens, so the page does not need a reload.
            // Polling (instead of one long setTimeout) also copes with throttled or sleeping tabs.
            var button = document.getElementById("pickup-submit");
            if (button.disabled) {
                var timer = setInterval(function () {
                    if (new Date() < earliest) return;
                    clearInterval(timer);
                    button.disabled = false;
                    var note = document.getElementById("pickup-closed-note");
                    if (note) note.remove();
                }, 5000);
            }

            form.addEventListener("submit", function (e) {
                if (new Date() < earliest) {
                    alert("Pickup opens " + earliest.toLocaleString("en-GB", { dateStyle: "short", timeStyle: "short" }) + ".");
                    e.preventDefault();
                    return;
                }
                if (new Date() >= start) return;
                var sameDay = start.toDateString() === new Date().toDateString();
                var time = start.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" });
                var when = sameDay ? "at " + time
                    : "on " + start.toLocaleDateString("en-GB", { day: "numeric", month: "short" }) + " at " + time;
                if (!confirm("The booking starts " + when + ". Hand over the vehicle anyway?"))
                    e.preventDefault();
            });
        })();
    </script>
}
