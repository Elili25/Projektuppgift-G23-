@using SeventWebApplication.Models.Users
@model List<BookingRowViewModel>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Pending approval";
}

<div class="adm-pagehead">
    <h2>@Model.Count booking(s) waiting for a decision</h2>
</div>

<section class="adm-card adm-panel">
    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead>
                <tr>
                    <th scope="col">Booking #</th>
                    <th scope="col">Customer</th>
                    <th scope="col">Vehicle</th>
                    <th scope="col">Dates</th>
                    <th scope="col">Status</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.ShortId</td>
                        <td>@b.CustomerName<br /><small>@b.CustomerMail</small></td>
                        <td>@b.Vehicle @b.RegNr</td>
                        <td>@b.Start.ToString("yyyy-MM-dd") → @b.End.ToString("yyyy-MM-dd") (@b.Days d)</td>
                        <td><span class="adm-status adm-status--pending">Pending</span></td>
                        <td>
                            <form class="adm-inline" method="post" asp-action="Approve" asp-route-id="@b.BookingId">
                                <button class="adm-btn adm-btn--ok" type="submit">Approve</button>
                            </form>
                            <form class="adm-inline" method="post" asp-action="Cancel" asp-route-id="@b.BookingId">
                                <button class="adm-btn adm-btn--danger" type="submit">Cancel</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr class="adm-table__empty"><td colspan="6">No pending bookings.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>
