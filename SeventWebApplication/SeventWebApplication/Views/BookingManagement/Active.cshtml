@using SeventWebApplication.Models.Users
@model List<BookingRowViewModel>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Active rentals";
}

<div class="adm-pagehead">
    <h2>@Model.Count active rental(s)</h2>
</div>

<section class="adm-card adm-panel">
    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead>
                <tr>
                    <th scope="col">Booking #</th>
                    <th scope="col">Customer</th>
                    <th scope="col">Vehicle</th>
                    <th scope="col">Dates</th>
                    <th scope="col">Status</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.ShortId</td>
                        <td>@b.CustomerName<br /><small>@b.CustomerMail</small></td>
                        <td>@b.Vehicle @b.RegNr</td>
                        <td>@b.Start.ToString("yyyy-MM-dd") → @b.End.ToString("yyyy-MM-dd") (@b.Days d)</td>
                        <td><span class="adm-status adm-status--active">Active</span></td>
                        <td>
                            <a class="adm-btn" asp-controller="Returns" asp-action="Register" asp-route-bookingId="@b.BookingId">Avsluta uthyrning</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr class="adm-table__empty"><td colspan="6">No active rentals.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>
