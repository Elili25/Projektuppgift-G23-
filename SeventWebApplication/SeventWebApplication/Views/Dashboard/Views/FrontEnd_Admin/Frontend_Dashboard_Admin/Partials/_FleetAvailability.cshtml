@*
    Fleet availability – munkdiagram + legend.
    Diagrammet ritas med conic-gradient: sätt --available, --rented, --service (i %) på .adm-donut när datan finns.
*@

<section class="adm-card adm-panel" aria-labelledby="adm-fleet-title">
    <div class="adm-panel__head">
        <h2 id="adm-fleet-title">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 3v9l6.5 6" /></svg>
            Fleet availability
        </h2>
    </div>

    <div class="adm-fleet">
        <div class="adm-donut" style="--available: 0; --rented: 0; --service: 0;">
            <div class="adm-donut__center">
                <strong>–</strong>
                <span>Available</span>
            </div>
        </div>

        <ul class="adm-legend">
            <li><span class="adm-legend__dot adm-legend__dot--available"></span>Available<span class="adm-legend__value">–</span></li>
            <li><span class="adm-legend__dot adm-legend__dot--rented"></span>Rented<span class="adm-legend__value">–</span></li>
            <li><span class="adm-legend__dot adm-legend__dot--service"></span>In service<span class="adm-legend__value">–</span></li>
        </ul>
    </div>
</section>
