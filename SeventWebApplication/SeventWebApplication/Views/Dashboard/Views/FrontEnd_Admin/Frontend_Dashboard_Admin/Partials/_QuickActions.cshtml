@*
    Quick actions – genvägar. href="#" pekar på sidor som inte finns än.
*@

<section class="adm-card adm-panel" aria-labelledby="adm-actions-title">
    <div class="adm-panel__head">
        <h2 id="adm-actions-title">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2L4 14h7l-1 8 9-12h-7z" /></svg>
            Quick actions
        </h2>
    </div>

    <div class="adm-actions">
        <a class="adm-action" href="#">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l1.6-4.2A2 2 0 0 1 8.5 6.5h7a2 2 0 0 1 1.9 1.3L19 12M4 17v-3a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3h-2M4 17h2M10 17h4" /><circle cx="8" cy="17" r="2" /><circle cx="16" cy="17" r="2" /></svg>
            Create car
        </a>
        <a class="adm-action" href="#">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 16V8a2 2 0 0 1 2-2h10l5 5v5h-2M3 16h2M9 16h6" /><circle cx="7" cy="16.5" r="2" /><circle cx="17" cy="16.5" r="2" /></svg>
            Create van
        </a>
        <a class="adm-action" asp-controller="Bookings" asp-action="Create">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4M12 13v5M9.5 15.5h5" /></svg>
            Create booking
        </a>
        <a class="adm-action" asp-controller="Bookings" asp-action="Index">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M8 8h8M8 12h8M8 16h5" /></svg>
            Manage bookings
        </a>
    </div>
</section>
