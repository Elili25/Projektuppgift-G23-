@using SeventWebApplication.Models.Admin
@model VehicleDetailsViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = $"{Model.Name} ({Model.RegNr})";

    // Sidan man kom ifrån (t.ex. Service & repairs). Bara lokala adresser godtas.
    string? returnUrl = Context.Request.Query["returnUrl"];
    if (!Url.IsLocalUrl(returnUrl)) { returnUrl = null; }
}

<div class="adm-pagehead">
    <h2>@Model.Name <small>@Model.RegNr</small></h2>
    <div>
        <a class="adm-btn adm-btn--ghost" href="@(returnUrl ?? Url.Action("Index"))">Back</a>
        <a class="adm-btn" asp-action="Edit" asp-route-id="@Model.VehicleId" asp-route-returnUrl="@returnUrl">Edit</a>
        <form class="adm-inline" method="post" asp-action="Delete" asp-route-id="@Model.VehicleId"
              data-confirm="Vill du radera @Model.Name (@Model.RegNr)? Det går inte att ångra.">
            <button class="adm-btn adm-btn--danger" type="submit">Delete</button>
        </form>
    </div>
</div>

<section class="adm-card adm-panel">
    <div class="adm-panel__head"><h2>Details</h2></div>
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img class="adm-thumb" src="@Model.ImagePath" alt="" style="max-width:240px;height:auto" />
    }
    <dl>
        <dt>Registration number</dt><dd>@Model.RegNr</dd>
        <dt>Type</dt><dd>@Model.Type</dd>
        <dt>Year</dt><dd>@Model.Year</dd>
        <dt>Status</dt>
        <dd>
            <span class="adm-status adm-status--@Model.Status.ToString().ToLower()">@Model.Status</span>
            @if (Model.IsRented) { <small> (rented out right now)</small> }
        </dd>
        <dt>Family</dt>
        <dd>
            @if (Model.FamilyId is Guid fid)
            {
                <a asp-controller="Families" asp-action="Details" asp-route-id="@fid">@Model.FamilyLabel</a>
            }
            else
            {
                <span>Not in any family</span>
            }
        </dd>
        <dt>Transmission</dt><dd>@Model.Transmission</dd>
        <dt>Fuel type</dt><dd>@Model.FuelType</dd>
        <dt>Passengers</dt><dd>@Model.PassengerCapacity</dd>
        <dt>Luggage (l)</dt><dd>@Model.LuggageCapacity</dd>
    </dl>
</section>

<section class="adm-card adm-panel">
    <div class="adm-panel__head"><h2>Booking history</h2></div>
    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead>
                <tr>
                    <th scope="col">Booking</th>
                    <th scope="col">Customer</th>
                    <th scope="col">Start</th>
                    <th scope="col">End</th>
                    <th scope="col">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Bookings)
                {
                    <tr>
                        <td><a asp-controller="Bookings" asp-action="Details" asp-route-id="@b.BookingId"><code>#@b.ShortId</code></a></td>
                        <td>@b.CustomerName</td>
                        <td>@b.Start.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@b.End.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="adm-status adm-status--@b.Status.ToString().ToLower()">@b.Status</span></td>
                    </tr>
                }
                @if (Model.Bookings.Count == 0)
                {
                    <tr class="adm-table__empty"><td colspan="5">No bookings for this vehicle yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="adm-card adm-panel">
    <div class="adm-panel__head"><h2>Damages</h2></div>
    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead>
                <tr>
                    <th scope="col">Description</th>
                    <th scope="col">Reported</th>
                    <th scope="col">Resolved</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Damages)
                {
                    <tr>
                        <td>@d.Description</td>
                        <td>@d.ReportedAt.ToString("yyyy-MM-dd")</td>
                        <td>@(d.IsResolved ? "Yes" : "No")</td>
                    </tr>
                }
                @if (Model.Damages.Count == 0)
                {
                    <tr class="adm-table__empty"><td colspan="3">No damages reported.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>
