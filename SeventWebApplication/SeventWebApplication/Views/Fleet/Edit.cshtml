@using SeventWebApplication.Models.Admin
@using SeventWebApplication.Models.VehicleNS
@model VehicleEditForm
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit vehicle";

    string? returnUrl = Context.Request.Query["returnUrl"];
    if (!Url.IsLocalUrl(returnUrl)) { returnUrl = null; }
}

<section class="adm-card adm-panel">
    <form method="post" asp-action="Edit" asp-route-returnUrl="@returnUrl" enctype="multipart/form-data">
        @if (ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
        {
            <ul class="adm-errors">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@e.ErrorMessage</li>
                }
            </ul>
        }

        <input type="hidden" asp-for="VehicleId" />

        <div class="adm-form">
            <label class="adm-field adm-field--wide">Image
                @if (!string.IsNullOrEmpty(Model.CurrentImagePath))
                {
                    <img class="adm-thumb" src="@Model.CurrentImagePath" alt="" />
                }
                <input type="file" name="Image" accept="image/png,image/jpeg,image/webp" />
                <small>Optional. Leave empty to keep the current image.</small>
            </label>
            <label class="adm-field">Registration number
                <input asp-for="RegNr" id="regnr-input" placeholder="@RegNrFormatHints.For(Model.CountryCode)" autocomplete="off" />
                <small id="regnr-hint">Format: @RegNrFormatHints.For(Model.CountryCode)</small>
            </label>
            <label class="adm-field">Country
                <select asp-for="CountryCode" asp-items="Html.GetEnumSelectList<CountryCode>()" id="country-select"></select>
            </label>
            <label class="adm-field">Brand
                <input asp-for="Brand" />
            </label>
            <label class="adm-field">Model
                <input asp-for="ModelName" />
            </label>
            <label class="adm-field">Year
                <input asp-for="Year" type="number" />
            </label>
            <label class="adm-field">Passenger capacity
                <input asp-for="PassengerCapacity" type="number" />
            </label>
            <label class="adm-field">Luggage capacity (l)
                <input asp-for="LuggageCapacity" type="number" step="any" />
            </label>
        </div>
        <p><small>Engine, transmission and class (@Model.TypeName) cannot be changed. Add a new vehicle instead.</small></p>

        <p style="margin-top:18px">
            <button class="adm-btn" type="submit">Save changes</button>
            <a class="adm-btn adm-btn--ghost" asp-action="Details" asp-route-id="@Model.VehicleId" asp-route-returnUrl="@returnUrl">Cancel</a>
        </p>
    </form>
</section>

@section Scripts {
    <script>
        // Formatexempel per land som placeholder och hjälptext för regnumret
        (function () {
            var hints = { SE: "@RegNrFormatHints.Sweden", DE: "@RegNrFormatHints.Germany", UK: "@RegNrFormatHints.UK",
                          NO: "@RegNrFormatHints.Norway", DK: "@RegNrFormatHints.Denmark", FI: "@RegNrFormatHints.Finland" };
            var country = document.getElementById("country-select");
            var input = document.getElementById("regnr-input");
            var hint = document.getElementById("regnr-hint");
            function update() {
                var h = hints[country.options[country.selectedIndex].text] || "";
                input.placeholder = h;
                hint.textContent = "Format: " + h;
            }
            country.addEventListener("change", update);
            update();
        })();
    </script>
}
