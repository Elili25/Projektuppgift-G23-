@using SeventWebApplication.Models.Admin
@using SeventWebApplication.Models.VehicleNS
@model FamilyPageViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Vehicle families";
}

<section class="adm-card adm-panel">
    <div class="adm-panel__head"><h2>Existing families</h2></div>
    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead>
                <tr>
                    <th scope="col"></th>
                    <th scope="col">Name</th>
                    <th scope="col">Type</th>
                    <th scope="col">Transmission</th>
                    <th scope="col">Description</th>
                    <th scope="col">Matching vehicles</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Families)
                {
                    <tr>
                        <td>@if (!string.IsNullOrEmpty(f.ImagePath)) { <img class="adm-thumb" src="@f.ImagePath" alt="" /> }</td>
                        <td><a asp-action="Details" asp-route-id="@f.FamilyId">@f.Name</a></td>
                        <td>@f.Kind</td>
                        <td>@f.Transmission</td>
                        <td>@f.Description</td>
                        <td>@f.VehicleCount</td>
                        <td>
                            <a class="adm-btn adm-btn--ghost" asp-action="Details" asp-route-id="@f.FamilyId">View</a>
                            <a class="adm-btn adm-btn--ghost" asp-action="Edit" asp-route-id="@f.FamilyId">Edit</a>
                            <form class="adm-inline" method="post" asp-action="Delete" asp-route-id="@f.FamilyId"
                                  data-confirm="Vill du radera familjen @f.Name? Det går inte att ångra.">
                                <button class="adm-btn adm-btn--danger" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Families.Count == 0)
                {
                    <tr class="adm-table__empty"><td colspan="7">No families yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="adm-card adm-panel">
    <div class="adm-panel__head"><h2>Create family</h2></div>
    <form method="post" asp-action="Create" enctype="multipart/form-data">
        @if (ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
        {
            <ul class="adm-errors">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@e.ErrorMessage</li>
                }
            </ul>
        }

        @if (Model.DuplicateWarning is string warning)
        {
            <div class="adm-flash adm-flash--error">
                @warning
                <label style="display:block;margin-top:8px">
                    <input type="checkbox" name="ConfirmDuplicate" value="true" /> Ja, skapa ändå
                </label>
            </div>
        }

        <div class="adm-form">
            <label class="adm-field adm-field--wide">Image
                <input type="file" name="Image" accept="image/png,image/jpeg,image/webp" />
                <small>Optional. PNG, JPG or WebP, max 5 MB. A transparent PNG with the vehicle from the side looks best.</small>
            </label>
            <label class="adm-field">Type
                <select asp-for="Form.Type" name="Type" asp-items="Html.GetEnumSelectList<VehicleType>()" id="family-type"></select>
            </label>
            <label class="adm-field">Name
                <input name="Name" value="@Model.Form.Name" />
            </label>
            <label class="adm-field">Transmission
                <select name="TransmissionType" asp-items="@(new SelectList(Enum.GetNames<TransmissionType>(), Model.Form.TransmissionType.ToString()))"></select>
            </label>
            <label class="adm-field adm-field--wide">Description
                <input name="Description" value="@Model.Form.Description" />
            </label>

            <label class="adm-field" data-for="Car">Comfort level
                <select name="Comfort" asp-items="@(new SelectList(Enum.GetNames<VehicleComfortType>(), Model.Form.Comfort.ToString()))"></select>
            </label>
            <label class="adm-field" data-for="Car">Car category
                <select name="CarCategory" asp-items="@(new SelectList(Enum.GetNames<PassengerCarCategoryType>(), Model.Form.CarCategory.ToString()))"></select>
            </label>

            <label class="adm-field" data-for="Van">Van category
                <select name="VanCategory" asp-items="@(new SelectList(Enum.GetNames<VanCategoryType>(), Model.Form.VanCategory.ToString()))"></select>
            </label>
            <label class="adm-field" data-for="Van">Min cargo volume (m³)
                <input name="MinCargoVolumeM3" type="number" step="any" value="@Model.Form.MinCargoVolumeM3" />
            </label>
            <label class="adm-field" data-for="Van">Min payload (kg)
                <input name="MinPayloadKg" type="number" step="any" value="@Model.Form.MinPayloadKg" />
            </label>
            <label class="adm-field" data-for="Van">Min passengers
                <input name="MinPassengerCapacity" type="number" value="@Model.Form.MinPassengerCapacity" />
            </label>
        </div>

        <p style="margin-top:18px">
            <button class="adm-btn" type="submit">Create family</button>
        </p>
    </form>
</section>

<script>
    (function () {
        var select = document.getElementById("family-type");
        function update() {
            var current = select.options[select.selectedIndex].text;
            document.querySelectorAll("[data-for]").forEach(function (el) {
                el.style.display = el.getAttribute("data-for") === current ? "" : "none";
            });
        }
        select.addEventListener("change", update);
        update();
    })();
</script>
