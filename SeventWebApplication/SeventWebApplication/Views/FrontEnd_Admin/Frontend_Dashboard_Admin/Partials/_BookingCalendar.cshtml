@*
    Liten kalender på Overview: innevarande månad med prick på dagar som har bokningar.
    Samma data och rutnät som kalendersidan (/Calendar), bara i compact-läge.
*@
@using SeventWebApplication.Models.Admin
@using SeventWebApplication.Models.Booking
@using SeventWebApplication.Models.Users
@inject BookingRepository Bookings
@inject IUserRepository Users
@{
    var cal = CalendarViewModel.Build(Bookings.GetAll(), Users, DateTime.Today);
}

<section class="adm-card adm-panel" aria-labelledby="adm-calendar-title">
    <div class="adm-panel__head">
        <h2 id="adm-calendar-title">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
            Calendar
        </h2>
        <a class="adm-link" asp-controller="Calendar" asp-action="Index">View calendar →</a>
    </div>

    <div class="adm-cal">
        <div class="adm-cal__head">
            <a class="adm-icon-btn adm-icon-btn--sm" aria-label="Previous month" asp-controller="Calendar" asp-action="Index" asp-route-view="month" asp-route-date="@cal.PreviousMonth.ToString("yyyy-MM-dd")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></a>
            <strong>@cal.MonthName</strong>
            <a class="adm-icon-btn adm-icon-btn--sm" aria-label="Next month" asp-controller="Calendar" asp-action="Index" asp-route-view="month" asp-route-date="@cal.NextMonth.ToString("yyyy-MM-dd")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></a>
        </div>

        <partial name="~/Views/FrontEnd_Admin/Frontend_Dashboard_Admin/Partials/_CalendarGrid.cshtml" model="cal" view-data="@(new ViewDataDictionary(ViewData) { { "Compact", true } })" />
    </div>
</section>
