@*
    Kalender för innevarande månad. Rutnätet räknas fram här, bokningsprickar
    (class="has-booking" på en dag) läggs till när datan finns.
*@
@{
    var today = DateTime.Today;
    var first = new DateTime(today.Year, today.Month, 1);
    var daysInMonth = DateTime.DaysInMonth(today.Year, today.Month);
    var offset = ((int)first.DayOfWeek + 6) % 7;   // måndag = 0
    var monthName = first.ToString("MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
}

<section class="adm-card adm-panel" aria-labelledby="adm-calendar-title">
    <div class="adm-panel__head">
        <h2 id="adm-calendar-title">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
            Calendar
        </h2>
        <a class="adm-link" href="#">View calendar →</a>
    </div>

    <div class="adm-cal">
        <div class="adm-cal__head">
            <button class="adm-icon-btn adm-icon-btn--sm" type="button" aria-label="Previous month"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></button>
            <strong>@monthName</strong>
            <button class="adm-icon-btn adm-icon-btn--sm" type="button" aria-label="Next month"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
        </div>

        <div class="adm-cal__grid">
            @foreach (var d in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
            {
                <span class="adm-cal__dow">@d</span>
            }
            @for (var i = 0; i < offset; i++)
            {
                <span></span>
            }
            @for (var day = 1; day <= daysInMonth; day++)
            {
                <span class="adm-cal__day @(day == today.Day ? "is-today" : "")">@day</span>
            }
        </div>
    </div>
</section>
