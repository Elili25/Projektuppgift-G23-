@*
    KPI-kort med värden från DashboardViewModel.
*@

@using SeventWebApplication.Models.Admin
@model DashboardViewModel
@{
    var sv = System.Globalization.CultureInfo.GetCultureInfo("sv-SE");
}

<section class="adm-kpis" aria-label="Key figures">

    <article class="adm-card adm-kpi">
        <span class="adm-kpi__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg></span>
        <div>
            <span class="adm-kpi__label">Active bookings</span>
            <strong class="adm-kpi__value">@Model.ActiveBookings</strong>
            <span class="adm-kpi__trend">@Model.PendingBookings awaiting approval</span>
        </div>
    </article>

    <article class="adm-card adm-kpi">
        <span class="adm-kpi__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l1.6-4.2A2 2 0 0 1 8.5 6.5h7a2 2 0 0 1 1.9 1.3L19 12M4 17v-3a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3h-2M4 17h2M10 17h4" /><circle cx="8" cy="17" r="2" /><circle cx="16" cy="17" r="2" /></svg></span>
        <div>
            <span class="adm-kpi__label">Available vehicles</span>
            <strong class="adm-kpi__value">@Model.AvailableVehicles</strong>
            <span class="adm-kpi__trend">of @Model.TotalVehicles vehicles</span>
        </div>
    </article>

    <article class="adm-card adm-kpi">
        <span class="adm-kpi__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 6.5a4 4 0 0 0-5.3 5.3L4 17l3 3 5.2-5.2a4 4 0 0 0 5.3-5.3l-2.5 2.5-2.5-.5-.5-2.5z" /></svg></span>
        <div>
            <span class="adm-kpi__label">In service</span>
            <strong class="adm-kpi__value">@Model.InServiceVehicles</strong>
            <span class="adm-kpi__trend">@Model.InRepairVehicles in repair</span>
        </div>
    </article>

    <article class="adm-card adm-kpi">
        <span class="adm-kpi__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="6" rx="7" ry="3" /><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6" /></svg></span>
        <div>
            <span class="adm-kpi__label">Revenue (this month)</span>
            <strong class="adm-kpi__value">@Model.RevenueThisMonth.ToString("N0", sv) kr</strong>
            <span class="adm-kpi__trend">@Model.RevenueBookings approved booking(s)</span>
        </div>
    </article>

</section>
