@*
    Kommande bokningar – de närmaste (väntande, bekräftade och pågående), från DashboardViewModel.
*@
@using SeventWebApplication.Models.Admin
@using SeventWebApplication.Models.Booking
@model DashboardViewModel

<section class="adm-card adm-panel" aria-labelledby="adm-bookings-title">
    <div class="adm-panel__head">
        <h2 id="adm-bookings-title">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
            Upcoming bookings
        </h2>
        <a class="adm-link" asp-controller="Bookings" asp-action="Index">View all →</a>
    </div>

    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead>
                <tr>
                    <th scope="col">Booking #</th>
                    <th scope="col">Customer</th>
                    <th scope="col">Vehicle</th>
                    <th scope="col">Dates</th>
                    <th scope="col">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.UpcomingBookings)
                {
                    <tr>
                        <td>#@b.ShortId</td>
                        <td>@b.CustomerName</td>
                        <td>@b.Vehicle <small>@b.RegNr</small></td>
                        <td>@b.Start.ToString("d MMM") → @b.End.ToString("d MMM")</td>
                        <td><span class="adm-status adm-status--@b.Status.ToString().ToLower()">@b.Status</span></td>
                    </tr>
                }
                @if (Model.UpcomingBookings.Count == 0)
                {
                    <tr class="adm-table__empty">
                        <td colspan="5">No upcoming bookings.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
