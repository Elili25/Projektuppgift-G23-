@*
    Sevent – Admin dashboard (Operation Overview)
    Styles: wwwroot/css/Sevent-AdminDashboard.css

    Datan kommer från AdminController via DashboardViewModel. Partialerna ärver modellen,
    förutom kalendern som läser bokningarna själv.
*@
@using SeventWebApplication.Models.Admin
@model DashboardViewModel
@{
    Layout = null;   // egen layout med sidebar, inte publika _Layout
    ViewData["Title"] = "Operation Overview";
    const string Root = "~/Views/FrontEnd_Admin/Frontend_Dashboard_Admin/";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Sevent Admin</title>
    <link rel="stylesheet" href="~/css/Sevent-AdminDashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Sevent-AdminPages.css" asp-append-version="true" />
</head>
<body class="adm">

    <div class="adm-shell">

        @await Html.PartialAsync(Root + "_AdminSidebar.cshtml")

        <div class="adm-main">

            @await Html.PartialAsync(Root + "_AdminNavbar.cshtml")

            <main class="adm-content">

                @if (TempData["Success"] is string ok)
                {
                    <div class="adm-flash adm-flash--ok">@ok</div>
                }
                @if (TempData["Error"] is string err)
                {
                    <div class="adm-flash adm-flash--error">@err</div>
                }

                @* KPI-kort: Active bookings, Available vehicles, In service, Revenue *@
                @await Html.PartialAsync(Root + "Partials/_StatisticsOverview.cshtml")

                <div class="adm-row adm-row--bookings">
                    @await Html.PartialAsync(Root + "Partials/_UpcomingBookings.cshtml")
                    @await Html.PartialAsync(Root + "Partials/_BookingCalendar.cshtml")
                </div>

                <div class="adm-row adm-row--fleet">
                    @await Html.PartialAsync(Root + "Partials/_FleetAvailability.cshtml")
                    @await Html.PartialAsync(Root + "Partials/_QuickActions.cshtml")
                </div>

                @* Märkes- och modellregistret (lägg till kombinationer) *@
                @await Html.PartialAsync(Root + "Partials/_BrandCatalog.cshtml")

            </main>

            @await Html.PartialAsync(Root + "_AdminFooter.cshtml")
        </div>
    </div>

</body>
</html>
