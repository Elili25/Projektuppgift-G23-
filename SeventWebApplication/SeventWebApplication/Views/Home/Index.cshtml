@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
@{
    ViewData["Title"] = "Översikt";
}

<div class="page-content">

    <!-- Sidhuvud -->
    <div class="page-header">
        <div>
            <h1>Välkommen till Sevent</h1>
            <p class="page-subtitle">
                Här är en översikt över din verkstad.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary">
            + Testknapp
        </a>
    </div>

    <!-- Statistik -->
    <div class="stats-grid">

        <div class="stat-card">
            <span class="stat-label">Dagens bokningar</span>
            <span class="stat-value">12</span>
            <span class="badge-status status-confirmed">
                +3 idag
            </span>
        </div>

        <div class="stat-card">
            <span class="stat-label">Lediga tider</span>
            <span class="stat-value">8</span>
            <span class="badge-status status-ongoing">
                Tillgängliga
            </span>
        </div>

        <div class="stat-card">
            <span class="stat-label">Väntande bokningar</span>
            <span class="stat-value">4</span>
            <span class="badge-status status-pending">
                Kräver åtgärd
            </span>
        </div>

        <div class="stat-card">
            <span class="stat-label">Avbokningar</span>
            <span class="stat-value">2</span>
            <span class="badge-status status-cancelled">
                Avbokade
            </span>
        </div>

    </div>

    <!-- Knappar -->
    <div class="card mb-4">
        <div class="card-header">
            <h2>Knappar och komponenter</h2>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" type="button">
                Primär knapp
            </button>

            <button class="btn btn-secondary" type="button">
                Sekundär knapp
            </button>

            <button class="btn btn-danger" type="button">
                Ta bort
            </button>

            <button class="btn btn-outline-primary" type="button">
                Alternativ knapp
            </button>
        </div>
    </div>

    <!-- Formulär -->
    <div class="card mb-4">
        <div class="card-header">
            <h2>Testa ett bokningsformulär</h2>
        </div>

        <form>
            <div class="row g-3">

                <div class="col-md-6">
                    <label for="customerName" class="form-label">
                        Kundnamn
                    </label>
                    <input id="customerName"
                           class="form-control"
                           placeholder="Ex. Anna Andersson" />
                </div>

                <div class="col-md-6">
                    <label for="registration" class="form-label">
                        Registreringsnummer
                    </label>
                    <input id="registration"
                           class="form-control"
                           placeholder="ABC123" />
                </div>

                <div class="col-md-6">
                    <label for="service" class="form-label">
                        Typ av service
                    </label>
                    <select id="service" class="form-select">
                        <option>Välj service</option>
                        <option>Däckbyte</option>
                        <option>Däckreparation</option>
                        <option>Övrig service</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label for="bookingDate" class="form-label">
                        Bokningsdatum
                    </label>
                    <input id="bookingDate"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-12">
                    <button type="button" class="btn btn-primary">
                        Spara testbokning
                    </button>
                </div>

            </div>
        </form>
    </div>

    <!-- Bokningstabell -->
    <div class="card">
        <div class="card-header">
            <h2>Senaste bokningarna</h2>
            <span class="text-muted">Demodata</span>
        </div>

        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>Tid</th>
                        <th>Kund</th>
                        <th>Fordon</th>
                        <th>Service</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>09:00</td>
                        <td>Anna Andersson</td>
                        <td>ABC123</td>
                        <td>Däckbyte</td>
                        <td>
                            <span class="badge-status status-confirmed">
                                Bekräftad
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <td>10:30</td>
                        <td>Erik Johansson</td>
                        <td>XYZ789</td>
                        <td>Däckreparation</td>
                        <td>
                            <span class="badge-status status-pending">
                                Väntande
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <td>13:00</td>
                        <td>Maria Svensson</td>
                        <td>DEF456</td>
                        <td>Däckbyte</td>
                        <td>
                            <span class="badge-status status-ongoing">
                                Pågår
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <td>14:30</td>
                        <td>Johan Karlsson</td>
                        <td>GHI789</td>
                        <td>Övrig service</td>
                        <td>
                            <span class="badge-status status-cancelled">
                                Avbokad
                            </span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>
```
