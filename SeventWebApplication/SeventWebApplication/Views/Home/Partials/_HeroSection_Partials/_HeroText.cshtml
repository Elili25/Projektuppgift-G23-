@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    <head>
        <link rel="stylesheet" href="~/css/Sevent-HeroText-Partial.css" asp-append-version="true" />
    </head>
    <div class="hero-content">

    <span class="hero-badge">
        RENT A CAR WITH SEVENT
    </span>

    <h1>
        Move freely<br />
        with Sevent.
    </h1>

    <p>
        A modern car rental experience with a wide
        selection of vehicles, great flexibility and
        transparent pricing.
    </p>

    <div class="hero-actions">

        <a asp-controller="Vehicles"
           asp-action="Index"
           class="btn-primary">
            Explore vehicles
        </a>

        <a asp-controller="Home"
           asp-action="About"
           class="btn-secondary">
            How it works
        </a>

    </div>

</div>
}
