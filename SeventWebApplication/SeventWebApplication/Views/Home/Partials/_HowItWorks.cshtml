@*
    "How It Works": tre steg i en rad med mjuka lila vågor i botten. Styles: wwwroot/css/Sevent-HowItWorks.css
*@

<link rel="stylesheet" href="~/css/Sevent-HowItWorks.css" asp-append-version="true" />

<section class="hiw" aria-labelledby="hiw-title">
    <h2 class="hiw__title" id="hiw-title">How It Works</h2>

    <ol class="hiw__steps">
        <li class="hiw__step">
            <span class="hiw__no">1</span>
            <div>
                <strong>Choose your car</strong>
                <p>Find the vehicle that fits your needs.</p>
            </div>
        </li>
        <li class="hiw__step">
            <span class="hiw__no">2</span>
            <div>
                <strong>Book online</strong>
                <p>Select your dates and send your request.</p>
            </div>
        </li>
        <li class="hiw__step">
            <span class="hiw__no">3</span>
            <div>
                <strong>Pick up and go</strong>
                <p>Collect your car and enjoy the journey.</p>
            </div>
        </li>
    </ol>
</section>
