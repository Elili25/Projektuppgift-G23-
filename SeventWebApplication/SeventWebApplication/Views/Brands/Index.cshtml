@*
    Brands & models – registret som Fleet/Create väljer ur. Här lägger admin till nya märke/modell-kombinationer.
    Postar till Brands/Add, som skickar tillbaka hit.
*@
@using SeventWebApplication.Models.VehicleNS
@model List<CatalogBrand>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Brands & models";
}

<section class="adm-card adm-panel" aria-labelledby="adm-catalog-title">
    <div class="adm-panel__head">
        <h2 id="adm-catalog-title">Brands &amp; models</h2>
    </div>

    <form method="post" asp-controller="Brands" asp-action="Add" class="adm-form">
        <label class="adm-field">Type
            <select name="type" asp-items="Html.GetEnumSelectList<VehicleType>()"></select>
        </label>
        <label class="adm-field">Brand
            <input name="brand" list="adm-brand-list" required maxlength="40" autocomplete="off" />
            <datalist id="adm-brand-list">
                @foreach (var b in Model)
                {
                    <option value="@b.Name"></option>
                }
            </datalist>
        </label>
        <label class="adm-field">Model
            <input name="model" required maxlength="40" autocomplete="off" />
        </label>
        <div class="adm-field">
            <button class="adm-btn" type="submit">Add</button>
        </div>
    </form>
</section>

<section class="adm-card adm-panel">
    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead><tr><th>Brand</th><th>Models</th></tr></thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr><td><strong>@b.Name</strong></td><td>@string.Join(", ", b.Models)</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>
